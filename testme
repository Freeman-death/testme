#!/usr/bin/env python3
"""
TestMe - Student Project Testing Framework

USAGE:
  testme <project-name> <path>     Test a supported project (libft, ft_printf, ...)
  testme list                      List available project types
  testme install <project>         Install test infrastructure for a project
  testme update                    Update TestMe to latest version

Each project's tests live in their own file under projects/:
  projects/base.py       Shared ProjectTest base class (build/test flow)
  projects/libft.py      libft structure checks and install templates
  projects/ft_printf.py  ft_printf structure checks, install templates and
                         differential tests against the real printf()

This framework provides standardized testing for student projects,
with integrated CI/CD, test reporting, and subagent workflows.
"""

import sys
import os
import argparse
import importlib.util
import shutil
import subprocess
from pathlib import Path


class TestMeCLI:
    def __init__(self):
        self.projects = self.load_projects()

    # ------------------------------------------------------------------ #
    # Project suite loading - one file per project under projects/
    # ------------------------------------------------------------------ #

    def load_projects(self):
        script_dir = Path(__file__).resolve().parent
        candidates = [
            script_dir / "projects",
            Path.home() / ".local/share/testme/projects",
        ]

        for projects_dir in candidates:
            if not projects_dir.is_dir():
                continue
            sys.path.insert(0, str(projects_dir))
            return self._load_from_dir(projects_dir)

        print("⚠️  No projects/ directory found with test suites")
        return {}

    def _load_from_dir(self, projects_dir: Path):
        import base

        projects = {}
        for file in sorted(projects_dir.glob("*.py")):
            if file.name.startswith("_"):
                continue
            try:
                spec = importlib.util.spec_from_file_location(
                    f"testme_project_{file.stem}", file)
                module = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(module)
            except Exception as e:
                print(f"⚠️  Failed to load project suite {file.name}: {e}")
                continue
            for attr in dir(module):
                obj = getattr(module, attr)
                if (isinstance(obj, type) and issubclass(obj, base.ProjectTest)
                        and obj is not base.ProjectTest
                        and obj.__module__ == module.__name__):
                    projects[obj.name] = obj()
        return projects

    # ------------------------------------------------------------------ #
    # Commands
    # ------------------------------------------------------------------ #

    def show_help(self):
        print("TestMe - Student Project Testing Framework")
        print()
        print("Usage:")
        print("  testme <project-name> <path>    Test project at given path")
        print("                                  (e.g. testme libft . or testme ft_printf .)")
        print("  testme list                     List available project types")
        print("  testme install <project>        Install test infrastructure")
        print("  testme update                   Update TestMe to latest version")
        print()
        print("Commands:")
        print("  testme                          Show this help")

    def list_projects(self):
        print("Available project types:")
        print()
        for name, project in self.projects.items():
            print(f"  {name:20} - {project.description}")

    def check_requirements(self, project_name: str) -> bool:
        project = self.projects.get(project_name)
        if not project:
            print(f"Unknown project type: {project_name}")
            return False
        return project.check_requirements()

    def run_tests(self, project_name: str, path: str) -> bool:
        project = self.projects.get(project_name)
        if not project:
            available = ", ".join(self.projects) if self.projects else "none"
            print(f"Unknown project type: {project_name}")
            print(f"Available project types: {available}")
            return False
        return project.run_tests(path)

    def install_infrastructure(self, project_name: str) -> bool:
        project = self.projects.get(project_name)
        if not project:
            available = ", ".join(self.projects) if self.projects else "none"
            print(f"Unknown project type: {project_name}")
            print(f"Available project types: {available}")
            return False
        return project.install_infrastructure()

    def update(self) -> int:
        print("🔄 Updating TestMe CLI...")
        tmp_dir = "/tmp/testme_update"
        try:
            # Download the repo tarball to refresh both the CLI and projects/
            subprocess.run(
                ["curl", "-sSL",
                 "https://api.github.com/repos/Freeman-death/testme/tarball/main",
                 "-o", f"{tmp_dir}.tar.gz"],
                check=True
            )
            shutil.rmtree(tmp_dir, ignore_errors=True)
            os.makedirs(tmp_dir)
            subprocess.run(
                ["tar", "-xzf", f"{tmp_dir}.tar.gz", "-C", tmp_dir],
                check=True
            )
            matches = [d for d in Path(tmp_dir).iterdir()
                       if d.is_dir() and d.name.endswith("-testme-main")]
            if not matches:
                print("❌ Update failed: could not locate extracted repository")
                return 1
            src = matches[0]
            target = os.path.expanduser("~/.local/bin/testme")
            shutil.copy(src / "testme", target)
            os.chmod(target, 0o755)
            # Refresh per-project test suites
            projects_src = src / "projects"
            if projects_src.is_dir():
                projects_dst = Path.home() / ".local/share/testme/projects"
                shutil.rmtree(projects_dst, ignore_errors=True)
                shutil.copytree(projects_src, projects_dst)
            shutil.rmtree(tmp_dir, ignore_errors=True)
            os.remove(f"{tmp_dir}.tar.gz")
            print("✅ TestMe updated successfully!")
            return 0
        except Exception as e:
            print(f"❌ Update failed: {e}")
            return 1

    def run(self) -> int:
        parser = argparse.ArgumentParser(
            prog='testme',
            description='Student Project Testing Framework',
            add_help=False
        )

        parser.add_argument(
            'command',
            nargs='?',
            default='help',
            help='Command to execute'
        )

        parser.add_argument(
            'args',
            nargs='*',
            help='Additional arguments'
        )

        args = parser.parse_args(sys.argv[1:])

        try:
            if args.command == 'help' or not args.command:
                self.show_help()

            elif args.command == 'list':
                self.list_projects()

            elif args.command == 'update':
                return self.update()

            elif args.command == 'install':
                if not args.args:
                    print("Error: Missing project name for install command")
                    print("Usage: testme install <project-name>")
                    return 1
                if not self.install_infrastructure(args.args[0]):
                    return 1

            elif args.command and len(args.args) >= 1:
                success = self.run_tests(args.command, args.args[0])
                return 0 if success else 1

            else:
                print("Error: Invalid command or missing arguments")
                print("Usage: testme <project-name> <path>")
                return 1

        except KeyboardInterrupt:
            print("\nInterrupted by user")
            return 130
        except Exception as e:
            print(f"Error: {e}")
            return 1

        return 0


if __name__ == '__main__':
    sys.exit(TestMeCLI().run())
